{
  "_comment": "45m の本番: bklog の SAM45 のロギングを読み、/home/yk/bklog の下に YKSP のロギングを書く（docs/design/standin-study.md の「方針の見直し」）。board.host・board.bits は実機に合わせる",
  "watch": [
    ["/cosmos3/45m/bklog/sam45psw", "/home/yk/bklog/yksppsw"],
    ["/cosmos3/45m/bklog/sam45otf", "/home/yk/bklog/ykspotf"]
  ],
  "output": "separate",
  "in_backend": "SAM45",
  "in_prefix": "",
  "out_backend": "YKSP",
  "ifatt_mode": "follow",
  "assign": {
    "A05": ["A", 0], "A06": ["B", 0], "A07": ["C", 0], "A08": ["D", 0],
    "A21": ["A", 1], "A22": ["B", 1], "A23": ["C", 1], "A24": ["D", 1]
  },
  "sam45_if_ascending": true,
  "sam45_k_offset": 0.0,
  "tint_s": 0.01024,
  "scale": 1.0,
  "min_coverage": 0.9,
  "t_load_k": 293.0,
  "poll_s": 1.0,
  "ready_margin_s": 0.05,
  "ready_timeout_s": 5.0,
  "skip_existing": true,
  "board": {
    "host": "$B",
    "ctl_port": 51000,
    "data_port": 51001,
    "bits": {"fine": "sam45-fine", "wide": "sam45-wide"},
    "tmp_dir": "/var/tmp/sam45compat",
    "keep_tmp": false
  }
}
